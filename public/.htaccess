RewriteEngine On

DirectoryIndex index.html
AddType text/markdown .md
AddCharset utf-8 .md .txt .json .xml

# Agentes que piden Markdown reciben la version .md del inicio
RewriteCond %{HTTP_ACCEPT} text/markdown
RewriteRule ^$ /index.md [L]

# Archivos que existen se sirven tal cual
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Rutas de la aplicacion Angular. Si se agrega una ruta nueva en
# app.routes.ts hay que agregarla tambien aqui (y en sitemap.xml).
RewriteRule ^(quienes-somos|contacto)/?$ /index.html [L]
RewriteRule ^tour/[a-z0-9-]+/?$ /index.html [L]

# Cualquier otra URL devuelve un 404 real
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  <FilesMatch "^index\.(html|md)$">
    Header add Link "</llms.txt>; rel=describedby"
    Header add Link "</index.md>; rel=alternate"
    Header add Link "</sitemap.xml>; rel=sitemap"
    Header append Vary Accept
  </FilesMatch>
</IfModule>
